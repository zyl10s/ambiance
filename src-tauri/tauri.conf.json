{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ambiance",
  "version": "0.1.0",
  "identifier": "app.ambiance.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ambiance",
        "width": 1100,
        "height": 760,
        "minWidth": 780,
        "minHeight": 540,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}